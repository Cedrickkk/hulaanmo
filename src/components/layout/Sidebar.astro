---
import ThemeAvatar from "@/components/ui/ThemeAvatar.astro";
import Nav from "@/components/layout/Nav.astro";
import ExternalLinks from "@/components/layout/ExternalLinks.astro";
import { profile } from "@/lib/profile";
---

<div class="flex flex-col gap-8">
  <a href="/" class="flex flex-col items-start gap-5">
    <ThemeAvatar name={profile.name} />
    <div class="space-y-1">
      <p class="font-display text-4xl font-light tracking-normal">{profile.name}</p>
      <p class="text-sm font-medium text-[var(--color-fg)]">{profile.role}</p>
    </div>
     <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)] mt-3">
      <span class="italic">“moving at my own pace. <br /> always moving forward.”</span>
    </p>
  </a>
 
  <Nav />
  <ExternalLinks />
</div>
