---
import { externalLinks } from "@/lib/nav";

const icons: Record<string, { content: string; filled?: boolean }> = {
  "@github": {
    content: `<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>`,
  },
  "@linkedin": {
    content: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
    filled: true,
  },
  "@gmail": {
    content: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
  "@resume": {
    content: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>`,
  },
};
---

<div class="flex flex-col items-start gap-y-3.5">
  {
    externalLinks.map(({ label, url }) => (
      <a
        href={url}
        target={url.startsWith("mailto:") ? undefined : "_blank"}
        rel="noopener noreferrer"
        class="flex items-center gap-x-2.5 py-0.5 text-[var(--color-muted)] transition-colors duration-200 hover:text-[var(--color-accent)] focus-visible:text-[var(--color-accent)]"
      >
        <svg
          viewBox="0 0 24 24"
          fill={icons[label].filled ? "currentColor" : "none"}
          stroke={icons[label].filled ? "none" : "currentColor"}
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-[18px] shrink-0"
          aria-hidden="true"
          set:html={icons[label].content}
        />
        <span class="font-mono text-sm tracking-tight">{label}</span>
      </a>
    ))
  }
</div>
