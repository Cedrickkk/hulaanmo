---
type Props = {
  title: string;
  author: string;
  note: string;
  link: string;
  cover?: string;
};
const { title, author, note, link, cover } = Astro.props;
---

<li class="reading-row">
  <div class="reading-art" aria-hidden="true">
    {cover ? (
      <img src={cover} alt="" width="56" height="80" loading="lazy" decoding="async" />
    ) : (
      <div class="resource-icon">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="6" width="24" height="17" rx="1" />
          <path d="m13 11 7 4-7 4v-8ZM11 27h10M16 23v4" />
        </svg>
      </div>
    )}
  </div>
  <div class="space-y-1">
    <h3 class="text-lg font-medium leading-snug">
      {link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" class="ink-link">{title}</a>
      ) : title}
    </h3>
    <p class="text-sm italic text-[var(--color-muted)]">{author}</p>
    <p class="pt-1 text-sm leading-relaxed">{note}</p>
  </div>
</li>

<style>
  .reading-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.25rem;
    align-items: start;
  }
  .reading-row:first-child { padding-top: 0; }
  .reading-row:last-child { padding-bottom: 0; }
  .reading-art { padding-top: .125rem; }
  .reading-art img {
    display: block;
    width: 56px;
    height: 80px;
    object-fit: contain;
    object-position: top left;
  }
  .resource-icon {
    display: flex;
    width: 56px;
    height: 72px;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 20%, transparent);
    border-radius: 2px;
  }
  @media (max-width: 400px) {
    .reading-row { grid-template-columns: 44px minmax(0, 1fr); gap: 1rem; }
    .reading-art img { width: 44px; height: 64px; }
    .resource-icon { width: 44px; height: 60px; }
  }
</style>
