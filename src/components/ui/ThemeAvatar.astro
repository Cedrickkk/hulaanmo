---
type Props = { name: string; size?: number; class?: string };
const { name, size = 200, class: className = "" } = Astro.props;
---

<span class:list={["theme-avatar", className]} role="img" aria-label={name} style={`width: ${size}px; height: ${size}px;`}>
  <img src="/me-avatar.jpg" alt="" width={size} height={size} class="theme-avatar-light" aria-hidden="true" />
  <img src="/me-avatar-2.jpg" alt="" width={size} height={size} class="theme-avatar-dark" aria-hidden="true" />
</span>
