---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import ReadingRow from "@/components/ui/ReadingRow.astro";
import { java, python, ai, systemDesign } from "@/data/books";
const sections = [
  { label: "System Design & Architecture", resources: systemDesign },
  { label: "AI Engineering", resources: ai.map(({ instructor, ...course }) => ({ ...course, author: instructor })) },
  { label: "Python", resources: python },
  { label: "Java", resources: java },
];
---

<BaseLayout
  title="Reading"
  description="Technical books John Cedric Panti is currently reading to deepen backend and AI engineering knowledge."
>
  <div class="space-y-6">
    <PageHeading title="Reading" />
    <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)]">
      These are the books and resources I'm exploring as I learn more about AI engineering, Java, Python, System Design, and Software Architecture.
    </p>
    <div class="space-y-8">
      {sections.map(({ label, resources }) => (
        <section class="space-y-4 first:mt-8" aria-label={label}>
          <h2 class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
            {label}
          </h2>
          <ul>
            {resources.map((resource) => <ReadingRow {...resource} />)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
