---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import { experience } from "@/data/experience";
---

<BaseLayout
  title="Experience"
  description="Professional full-stack web development roles held by John Cedric Panti."
>
  <div class="space-y-6">
    <PageHeading title="Experience" />
    <p class="max-w-[65ch] text-sm text-[var(--color-muted)]">
      A look at the roles I've taken on and the work I've done along the way.
    </p>
    <ul class="experience-timeline">
      {
        experience.map(({ role, company, type, period, bullets }) => (
          <li class="timeline-entry flex flex-col gap-y-1.5">
            <div class="flex items-baseline justify-between gap-x-4">
              <div class="flex flex-col items-start gap-x-1">
                <p class="text-base font-medium">{role}</p>
                <div class="flex items-center">
                  {company && (
                    <p class="text-sm">
                      {company}
                      {/* &nbsp; &middot; &nbsp; */}
                    </p>
                  )}
                  { /* <p class="text-sm italic">{type}</p> */}
                </div>
                <p class="text-xs tabular-nums md:hidden">{period}</p>
              </div>
              <p class="hidden shrink-0 text-xs tabular-nums md:block">
                {period}
              </p>
            </div>
            {bullets.length > 0 && (
              <ul class="ml-4 list-disc space-y-1 text-sm">
                {bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .timeline-entry {
    position: relative;
    padding-left: 1.75rem;
    padding-bottom: 2.25rem;
  }

  .timeline-entry::before {
    content: "";
    position: absolute;
    left: 0;
    top: .6rem;
    width: .5rem;
    height: .5rem;
    border: 1px solid var(--color-accent-soft);
    border-radius: 50%;
    background: var(--color-bg);
    z-index: 1;
  }

  .timeline-entry:first-child::before {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .timeline-entry:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(.25rem - .5px);
    top: .85rem;
    bottom: -.85rem;
    width: 1px;
    background: color-mix(in oklab, var(--color-accent) 24%, transparent);
  }

  .timeline-entry:last-child { padding-bottom: 0; }

  @media (min-width: 768px) {
    .timeline-entry { padding-left: 2rem; }
  }
</style>
