---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import { java, python, ai } from "@/data/books";
---

<BaseLayout
  title="Currently"
  description="Technical books John Cedric Panti is currently reading to deepen backend and AI engineering knowledge."
>
  <div class="space-y-6">
    <PageHeading title="Currently" />
    <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)]">
      I like reading technical books and exploring new technologies. These are
      what I'm currently working through to deepen my understanding of backend
      and AI Engineering with Java and Python.
    </p>
    <div class="space-y-8">
    <div class="space-y-3 mt-8">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          AI Engineering
        </p>
        <ul>
          {
            ai.map(({ title, instructor, note, link }) => (
              <li class="flex flex-col gap-y-1 py-5 first:pt-0">
                <p class="text-lg font-medium">
                  <a href={link} target="_blank" rel="noopener noreferrer" class="ink-link">
                    {title}
                  </a>
                  &nbsp;
                  <span class="font-sans text-sm italic">— {instructor}</span>
                </p>
                <p class="text-sm">{note}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="space-y-3 mt-8">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          Python
        </p>
        <ul>
          {
            python.map(({ title, author, note, link }) => (
              <li class="flex flex-col gap-y-1 py-5 first:pt-0">
                <p class="text-lg font-medium">
                  <a href={link} target="_blank" rel="noopener noreferrer" class="ink-link">
                    {title}
                  </a>
                  &nbsp;
                  <span class="font-sans text-sm italic">— {author}</span>
                </p>
                <p class="text-sm">{note}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="space-y-3">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          Java
        </p>
        <ul>
          {
            java.map(({ title, author, note, link }) => (
              <li class="flex flex-col gap-y-1 py-5 first:pt-0">
                <p class="text-lg font-medium">
                  <a href={link} target="_blank" rel="noopener noreferrer" class="ink-link">
                    {title}
                  </a>
                  &nbsp;
                  <span class="font-sans text-sm italic">— {author}</span>
                </p>
                <p class="text-sm">{note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
