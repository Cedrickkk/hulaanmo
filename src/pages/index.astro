---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import ContributionGraph from "@/components/ui/ContributionGraph.astro";
import { about } from "@/lib/profile";
---

<BaseLayout>
  <div class="space-y-6">
    <PageHeading title="About" />
    <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)]">
      {about.introduction}
    </p>

    <div class="space-y-8">
      <div class="space-y-3 mt-8">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          Goals
        </p>
        <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)]">
          {about.goals}
        </p>
      </div>

      <div class="space-y-3">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          Interests
        </p>
        <p class="max-w-[65ch] text-sm leading-relaxed text-[var(--color-muted)]">
          {about.interests}
        </p>
        <p class="text-xs italic leading-relaxed text-[var(--color-muted)]">
          {about.motto}
        </p>
      </div>

      <div class="space-y-3">
        <p class="font-mono text-xs tracking-[0.15em] text-[var(--color-muted)] uppercase">
          GitHub Activity
        </p>
        <ContributionGraph />
      </div>
    </div>
  </div>
</BaseLayout>
