---
import { ClientRouter } from "astro:transitions";
import MobileNav from "@/components/layout/MobileNav.astro";
import Sidebar from "@/components/layout/Sidebar.astro";
import { resolveSeo, siteConfig } from "@/lib/seo";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const { title, description } = resolveSeo(Astro.props);
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
const ogImageUrl = new URL(siteConfig.ogImage, siteConfig.url);
const isHome = Astro.url.pathname === "/";

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  url: siteConfig.url,
  image: ogImageUrl.toString(),
  jobTitle: "Java & Spring Boot Developer",
  description: siteConfig.description,
  sameAs: ["https://github.com/Cedrickkk", "https://linkedin.com/in/cedric-panti"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="keywords" content={siteConfig.keywords.join(", ")} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fdfdfb" />
    <link rel="manifest" data-theme-manifest href="/site.webmanifest?v=jcp-6" />
    <link rel="icon" data-theme-favicon data-light-icon="/favicon.ico" data-dark-icon="/favicon-dark.ico" type="image/x-icon" href="/favicon.ico?v=jcp-6" />
    <link rel="icon" data-theme-favicon data-light-icon="/favicon-16x16.png" data-dark-icon="/favicon-dark-16x16.png" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=jcp-6" />
    <link rel="icon" data-theme-favicon data-light-icon="/favicon-32x32.png" data-dark-icon="/favicon-dark-32x32.png" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=jcp-6" />
    <link rel="apple-touch-icon" data-theme-favicon data-light-icon="/apple-touch-icon.png" data-dark-icon="/apple-touch-icon-dark.png" sizes="180x180" href="/apple-touch-icon.png?v=jcp-6" />
    <script is:inline>
      (() => {
        if (window.__portfolioThemeReady) return;
        window.__portfolioThemeReady = true;
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const resolveTheme = () => systemTheme.matches ? "dark" : "light";
        let theme = resolveTheme();

        function applyTheme(doc = document) {
          doc.documentElement.dataset.theme = theme;
          doc.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content", theme === "dark" ? "#1c191f" : "#fdfdfb"
          );
          doc.querySelector('[data-theme-manifest]')?.setAttribute(
            "href", theme === "dark"
              ? "/site-dark.webmanifest?v=jcp-6"
              : "/site.webmanifest?v=jcp-6"
          );
          doc.querySelectorAll('[data-theme-favicon]').forEach((favicon) => {
            const faviconHref = favicon.getAttribute(
              theme === "dark" ? "data-dark-icon" : "data-light-icon"
            ) + "?v=jcp-6";
            if (favicon.getAttribute("href") !== faviconHref) {
              // Refresh every variant together so the browser cannot pick a stale light icon.
              const updatedFavicon = favicon.cloneNode(true);
              updatedFavicon.setAttribute("href", faviconHref);
              favicon.replaceWith(updatedFavicon);
            }
          });
        }

        applyTheme();
        document.addEventListener("astro:page-load", () => applyTheme());
        document.addEventListener("astro:before-swap", (event) => applyTheme(event.newDocument));
        systemTheme.addEventListener("change", () => {
          document.documentElement.classList.add("theme-motion");
          theme = resolveTheme();
          applyTheme();
        });

      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(siteConfig.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.ogImageHeight)} />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alumni+Sans:ital,wght@0,100..900;1,100..900&family=Geist:wght@100..900&family=Geist+Mono:wght@400..500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    {
      isHome && (
        <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
      )
    }
    <ClientRouter />
  </head>
  <body class="font-sans antialiased">
    <MobileNav />
    <div id="page" class="mx-auto w-full max-w-[1120px] px-6 py-8 md:px-10 md:py-20">
      <div class="grid grid-cols-1 gap-y-12 md:grid-cols-[260px_1fr] md:gap-x-20">
        <aside class="hidden md:sticky md:top-20 md:block md:h-fit">
          <Sidebar />
        </aside>
        <main transition:animate="fade" class="min-w-0 animate-fade-in">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
